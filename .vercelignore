# Allowlist: nothing is uploaded unless named below.
# Keeps local CLI state out of the deployment.
*
!index.html
!site_data.json
!counter_data.json
!vercel.json
# the server functions: the folder, then only these files inside it
!api
!api/read-menu.js
!api/ideas.js
!api/_models.js
# each shop's own menu: the folder, then only the .json files inside it
!menus
!menus/*.json
